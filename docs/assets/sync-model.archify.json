  "cards": [
    {
      "dot": "cyan",
      "title": "Who reads the Base",
      "items": [
        "Only sync's Merge reads it",
        "push and pull save it but never read it",
        "No usable Base: Merge is unavailable and sync guesses Use repository"
      ]
    },
    {
      "dot": "amber",
      "title": "When it changes",
      "items": [
        "Saved in repo form after a successful real run",
        "--dry-run and unselected rows never save it",
        "Git commits and checkouts do not reset it"
      ]
    },
    {
      "dot": "slate",
      "title": "Which targets keep one",
